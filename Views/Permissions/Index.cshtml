@model List<buildwave.Entities.Permission>

@{
    ViewData["Title"] = "Permissions";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Permissions</h2>
        <p class="text-muted mb-0">
            Manage ERP system permissions
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">

        <i class="bi bi-plus-lg"></i>
        Add Permission

    </a>

</div>

<div class="erp-card">

    <table class="table align-middle">

        <thead>

            <tr>
                <th>Name</th>
                <th>Key</th>
                <th width="180">Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var permission in Model)
            {
                <tr>

                    <td>
                        @permission.Name
                    </td>

                    <td>
                        <code>@permission.Key</code>
                    </td>

                    <td>

                        <a asp-action="Edit" asp-route-id="@permission.Id" class="btn btn-sm btn-dark">

                            Edit

                        </a>

                        <a asp-action="Delete" asp-route-id="@permission.Id" class="btn btn-sm btn-danger">

                            Delete

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>