@model buildwave.Entities.Permission

@{
    ViewData["Title"] = "Create Permission";
}

<div class="erp-card">

    <h2 class="mb-4">Create Permission</h2>

    <form method="post">

        <div class="mb-3">

            <label class="form-label">
                Permission Name
            </label>

            <input asp-for="Name" class="form-control" />

        </div>

        <div class="mb-4">

            <label class="form-label">
                Permission Key
            </label>

            <input asp-for="Key" class="form-control" placeholder="users.create" />

        </div>

        <button type="submit" class="btn btn-primary">

            Save Permission

        </button>

    </form>

</div>