@model buildwave.Entities.Role

@{
    ViewData["Title"] = "Manage Role Access";

    var permissions =
        ViewBag.Permissions as List<buildwave.Entities.Permission>;
}

<div class="page-header mb-4">

    <div>

        <h1 class="page-title">

            @Model.Name Permissions

        </h1>

        <p class="text-muted">

            Configure access rights for this role.

        </p>

    </div>

</div>

<div class="erp-card">

    <form method="post">

        <input type="hidden"
               name="roleId"
               value="@Model.Id" />

        <div class="row">

            @foreach (var permission in permissions!)
            {
                var assigned =
                    Model.RolePermissions.Any(rp =>
                        rp.PermissionId == permission.Id);

                <div class="col-md-4 mb-3">

                    <div class="permission-box">

                        <label class="d-flex align-items-center gap-2">

                            <input type="checkbox"
                                   name="permissionIds"
                                   value="@permission.Id"
                                   @(assigned ? "checked" : "") />

                            @permission.Name

                        </label>

                    </div>

                </div>
            }

        </div>

        <div class="mt-4 d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">

                Save Permissions

            </button>

            <a asp-controller="RolePermissions"
               asp-action="Index"
               class="btn btn-light">

                Cancel

            </a>

        </div>

    </form>

</div>