<!DOCTYPE html>
<html>

<head>
    <title>BuildWave ERP - Admin</title>

    <style>
            body {
                margin: 0;
                font-family: Arial;
                display: flex;
            }

            .sidebar {
                width: 220px;
                background: #1f2937;
                color: white;
                height: 100vh;
                padding: 20px;
            }

            .sidebar a {
                display: block;
                color: white;
                padding: 10px;
                text-decoration: none;
                margin-bottom: 5px;
            }

            .sidebar a:hover {
                background: #374151;
            }

            .content {
                flex: 1;
                padding: 20px;
                background: #f3f4f6;
            }

            .card {
                background: white;
                padding: 15px;
                border-radius: 8px;
                margin-bottom: 10px;
            }
    </style>
</head>

<body>

    <div class="sidebar">
        <h3>ERP Admin</h3>

        <a href="/Dashboard">Dashboard</a>
        <a href="/Admin/Users">Users</a>
    </div>

    <div class="content">
        @RenderBody()
    </div>

</body>

</html>