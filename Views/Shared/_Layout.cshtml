<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @(ViewData["Title"] ?? "ERP") - BuildWave
    </title>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ICONS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- FONT -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- APP CSS -->
    <link rel="stylesheet" href="~/css/erp.css" asp-append-version="true" />

</head>

<body>

    <!-- MOBILE OVERLAY -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="erp-sidebar" id="erpSidebar">

            <!-- BRAND -->
            <div class="sidebar-brand">

                <div class="brand-logo">
                    BW
                </div>

                <div class="brand-meta">

                    <div class="brand-title">
                        BuildWave
                    </div>

                    <div class="brand-subtitle">
                        Enterprise Suite
                    </div>

                </div>

            </div>

            <!-- NAV -->
            <nav class="sidebar-nav">

                <div class="nav-section-title">
                    MAIN
                </div>

                <a href="#" class="nav-item active">

                    <i class="bi bi-grid-1x2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

                <a href="#" class="nav-item">

                    <i class="bi bi-wallet2"></i>

                    <span>
                        Finance
                    </span>

                </a>

                <a href="#" class="nav-item">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        Inventory
                    </span>

                </a>

                <a href="#" class="nav-item">

                    <i class="bi bi-cart3"></i>

                    <span>
                        Procurement
                    </span>

                </a>

                <a href="#" class="nav-item">

                    <i class="bi bi-people"></i>

                    <span>
                        CRM
                    </span>

                </a>

                <a href="#" class="nav-item">

                    <i class="bi bi-person-badge"></i>

                    <span>
                        HR
                    </span>

                </a>

                <div class="nav-section-title">
                    ADMINISTRATION
                </div>

                <a asp-controller="Permissions" asp-action="Index" class="nav-item">

                    <i class="bi bi-key"></i>

                    <span>
                        Permissions
                    </span>

                </a>

                <a asp-controller="RolePermissions" asp-action="Index" class="nav-item">

                    <i class="bi bi-shield-lock"></i>

                    <span>
                        Role Access
                    </span>

                </a>

                <a href="#" class="nav-item">

                    <i class="bi bi-gear"></i>

                    <span>
                        Settings
                    </span>

                </a>

            </nav>

            <!-- SIDEBAR FOOTER -->
            <div class="sidebar-footer">

                <div class="sidebar-user">

                    <div class="user-avatar">

                        @((User.Identity?.Name ?? "U")[0])

                    </div>

                    <div class="user-info">

                        <div class="user-name">

                            @(User.Identity?.Name ?? "Unknown User")

                        </div>

                        <div class="user-role">

                            Administrator

                        </div>

                    </div>

                </div>

                <a asp-controller="Auth" asp-action="Logout" class="logout-btn">

                    <i class="bi bi-box-arrow-right"></i>

                </a>

            </div>

        </aside>

        <!-- MAIN -->
        <div class="app-main">

            <!-- TOPBAR -->
            <header class="erp-topbar">

                <!-- LEFT -->
                <div class="topbar-left">

                    <button class="mobile-menu-btn" id="mobileMenuBtn">

                        <i class="bi bi-list"></i>

                    </button>

                    <!-- GLOBAL SEARCH -->
                    <div class="global-search" id="commandTrigger">

                        <i class="bi bi-search"></i>

                        <span>
                            Search anything...
                        </span>

                        <kbd>
                            Ctrl K
                        </kbd>

                    </div>

                </div>

                <!-- RIGHT -->
                <div class="topbar-right">

                    <button class="topbar-btn">

                        <i class="bi bi-bell"></i>

                    </button>

                    <button class="topbar-btn" id="themeToggle">

                        <i class="bi bi-moon-stars"></i>

                    </button>

                </div>

            </header>

            <!-- PAGE -->
            <main class="page-container">

                @RenderBody()

            </main>

        </div>

    </div>

    <!-- COMMAND PALETTE -->
    <div class="command-palette" id="commandPalette">

        <div class="command-modal">

            <div class="command-search">

                <i class="bi bi-search"></i>

                <input type="text" placeholder="Search modules, actions, reports..." />

            </div>

            <div class="command-results">

                <div class="command-group">

                    <div class="command-group-title">
                        Navigation
                    </div>

                    <div class="command-item">

                        <i class="bi bi-grid-1x2"></i>

                        Dashboard

                    </div>

                    <div class="command-item">

                        <i class="bi bi-wallet2"></i>

                        Finance

                    </div>

                    <div class="command-item">

                        <i class="bi bi-box-seam"></i>

                        Inventory

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        // =========================================
        // COMMAND PALETTE
        // =========================================

        const palette =
        document.getElementById('commandPalette');

        const trigger =
        document.getElementById('commandTrigger');

        trigger.addEventListener('click', () => {

        palette.classList.add('show');

        });

        document.addEventListener('keydown', (e) => {

        if (e.ctrlKey && e.key === 'k') {

        e.preventDefault();

        palette.classList.add('show');

        }

        if (e.key === 'Escape') {

        palette.classList.remove('show');

        }

        });

        palette.addEventListener('click', (e) => {

        if (e.target === palette) {

        palette.classList.remove('show');

        }

        });

        // =========================================
        // MOBILE SIDEBAR
        // =========================================

        const sidebar =
        document.getElementById('erpSidebar');

        const mobileBtn =
        document.getElementById('mobileMenuBtn');

        const overlay =
        document.getElementById('mobileOverlay');

        mobileBtn.addEventListener('click', () => {

        sidebar.classList.toggle('show');

        overlay.classList.toggle('show');

        });

        overlay.addEventListener('click', () => {

        sidebar.classList.remove('show');

        overlay.classList.remove('show');

        });

        // =========================================
        // THEME
        // =========================================

        const themeToggle =
        document.getElementById('themeToggle');

        themeToggle.addEventListener('click', () => {

        document.body.classList.toggle('dark-mode');

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>