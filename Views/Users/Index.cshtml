@model IEnumerable<buildwave.Entities.User>

@{
    ViewData["Title"] = "Users";
}

<div class="page-header">

    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-subtitle">
            Manage system users
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Create User
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <table class="table align-middle mb-0">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Role</th>
                    <th width="260"></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>@user.FullName</td>

                        <td>@user.Email</td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            @(user.UserRoles.FirstOrDefault()?.Role?.Name ?? "-")
                        </td>

                        <td>

                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-dark">
                                Edit
                            </a>

                            @if (user.IsActive)
                            {
                                <a asp-action="Deactivate" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                    Disable
                                </a>
                            }
                            else
                            {
                                <a asp-action="Activate" asp-route-id="@user.Id" class="btn btn-sm btn-success">
                                    Activate
                                </a>
                            }

                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>